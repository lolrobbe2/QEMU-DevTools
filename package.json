{
  "name": "qemu-devtools",
  "displayName": "QEMU DevTools",
  "description": "qemu based developer tools, build in rendering to vscode panels.",
  "version": "0.0.1",
  "extensionDependencies": [
    "ms-vscode.cpptools"
  ],
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "qemu-devtools.showDisplay",
        "title": "Show Display"
      }
    ],
    "debuggers": [
      {
        "type": "qemudbg",
        "label": "QEMU Debug",
        "languages": [
          "c",
          "cpp"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "name",
              "program"
            ],
            "properties": {
              "program": {
                "type": "string"
              },
              "cwd": {
                "type": "string",
                "default": "${workspaceFolder}"
              },
              "name": {
                "type": "string",
                "description": "Debug configuration name"
              },
              "architeture": {
                "type": "string",
                "default": "x86_64"
              },
              "stopAtEntry": {
                "type": "boolean",
                "description": "Optional parameter. If true, the debugger should stop at the entry point of the target. If processId is passed, this has no effect."
              },
              "debuggerServerAddress": {
                "type": "string",
                "default": "localhost:1234",
                "description": "server address to use"
              },
              "executableType": {
                "type": "number",
                "enum": [
                  1,
                  2
                ],
                "enumDescriptions": [
                  "Console executable",
                  "Windows GUI executable"
                ],
                "default": 1,
                "description": "Type of executable being debugged."
              },
              "endianness": {
                "type": "number",
                "enum": [
                  1,
                  2
                ],
                "enumDescriptions": [
                  "Big-endian",
                  "Little-endian"
                ],
                "default": 2,
                "description": "Target architecture endianness."
              },
              "symbolFiles": {
                "type": "array",
                "description": "Symbol files to load into the debugger.",
                "items": {
                  "type": "object",
                  "required": [
                    "path"
                  ],
                  "properties": {
                    "path": {
                      "type": "string",
                      "description": "Path to the ELF symbol file. Supports VS Code variables such as ${workspaceFolder}."
                    },
                    "offset": {
                      "type": [
                        "string",
                        "number"
                      ],
                      "description": "Optional symbol relocation offset. If omitted, the ELF entry point will be used."
                    }
                  }
                },
                "default": []
              },
              "sourcePath": {
                "type": "string",
                "default": "${workspaceFolder}",
                "description": "Local source path used for GDB source path substitution."
              },
              "embbededDisplay":{
                "type": "boolean",
                "description": "When set to true qemu will be rendered inside a vscode tab."
              },
              "drives": {
                "type": "array",
                "description": "Drives to attach to the QEMU virtual machine.",
                "default": [],
                "items": {
                  "type": "object",
                  "required": [
                    "interface",
                    "format",
                    "file"
                  ],
                  "properties": {
                    "interface": {
                      "type": "string",
                      "enum": [
                        "pflash",
                        "virtio",
                        "ide",
                        "scsi",
                        "sata",
                        "floppy",
                        "sd"
                      ],
                      "default": "virtio",
                      "description": "Drive interface."
                    },
                    "format": {
                      "type": "string",
                      "enum": [
                        "raw",
                        "qcow2",
                        "qed",
                        "vdi",
                        "vhdx",
                        "vmdk",
                        "vpc"
                      ],
                      "default": "raw",
                      "description": "Disk image format."
                    },
                    "file": {
                      "type": "string",
                      "description": "Path to the disk image or FAT directory."
                    },
                    "readonly": {
                      "type": "boolean",
                      "default": false,
                      "description": "Attach the drive as read-only."
                    },
                    "fat": {
                      "type": "boolean",
                      "default": false,
                      "description": "Use a directory as a writable FAT drive."
                    }
                  }
                }
              },
              "devices": {
                "type": "array",
                "description": "QEMU devices to create.",
                "items": {
                  "type": "object",
                  "required": [
                    "driver"
                  ],
                  "properties": {
                    "driver": {
                      "type": "string",
                      "description": "QEMU device model, for example virtio-net-pci."
                    },
                    "properties": {
                      "type": "object",
                      "description": "Device-specific QEMU properties.",
                      "additionalProperties": {
                        "type": [
                          "string",
                          "number",
                          "boolean"
                        ]
                      }
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "name": "QEMU Debug",
            "type": "qemudbg",
            "request": "launch",
            "embbededDisplay": false
          }
        ]
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production && esbuild src/webview.js --bundle --platform=browser --outfile=out/webview.js --minify",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.140.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "dependencies": {
    "@novnc/novnc": "^1.7.0",
    "node-lief": "^1.3.2"
  }
}
